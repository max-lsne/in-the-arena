{
  "name": "whatsapp-arena",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @arena/db prisma generate",
    "db:migrate": "pnpm --filter @arena/db prisma migrate dev",
    "db:studio": "pnpm --filter @arena/db prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
