source "https://rubygems.org"

gem "rails", "~> 8.1.3", ">= 8.1.3.1"
gem "pg", "~> 1.5"

# activesupport 8.1.3.1 calls JSON.parse(source, options), a two-argument form
# that json 3.0 removed. Bundler resolves json 3.x by default and every jsonb
# round trip then raises ArgumentError. Pinned until activesupport supports it.
gem "json", "~> 2.7"
gem "puma", ">= 6.0"

# Vector similarity search over document chunks. Retrieval runs here rather than in
# the Python service so that row-level security applies to it. See ADR 0005.
gem "neighbor", "~> 0.5"

# The front end is served from a different origin in development.
gem "rack-cors"

gem "bootsnap", require: false
gem "tzinfo-data", platforms: %i[windows jruby]

group :development, :test do
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"
  gem "rspec-rails", "~> 7.1"
  gem "factory_bot_rails", "~> 6.4"
  gem "rubocop-rails-omakase", require: false
  gem "bundler-audit", require: false
end
